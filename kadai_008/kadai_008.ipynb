        "import random\n",
        "\n",
        "var = random.randint(0, 30)\n",
        "print(var)\n",
        "\n",
        "if (var % 3) == 0:\n",
        "    print(\"Fizz\")\n",
        "elif(var % 5) == 0:\n",
        "    print(\"Buzz\")\n",
        "elif(var % 15) == 0:\n",
        "    print(\"BuzzFizz\")\n",
        "else:\n",
        "    print(var)"
      ]
